+-- R3 word operations: truncate operands to 32 bits and sign-extend every result.
+def rv64w_low (x : Word) : BitVec 32 := x.extractLsb' 0 32
+
+def rv64w_add (x y : Word) : Word := ((rv64w_low x) + (rv64w_low y)).signExtend 64
+def rv64w_sub (x y : Word) : Word := ((rv64w_low x) - (rv64w_low y)).signExtend 64
+def rv64w_sll (x y : Word) : Word :=
+  ((rv64w_low x) <<< ((rv64w_low y).extractLsb' 0 5).toNat).signExtend 64
+def rv64w_srl (x y : Word) : Word :=
+  ((rv64w_low x) >>> ((rv64w_low y).extractLsb' 0 5).toNat).signExtend 64
+def rv64w_sra (x y : Word) : Word :=
+  (BitVec.sshiftRight (rv64w_low x) ((rv64w_low y).extractLsb' 0 5).toNat).signExtend 64
+def rv64w_slli (x : Word) (sh : BitVec 5) : Word := ((rv64w_low x) <<< sh.toNat).signExtend 64
+def rv64w_srli (x : Word) (sh : BitVec 5) : Word := ((rv64w_low x) >>> sh.toNat).signExtend 64
+def rv64w_srai (x : Word) (sh : BitVec 5) : Word :=
+  (BitVec.sshiftRight (rv64w_low x) sh.toNat).signExtend 64
+
+def rv64w_mul (x y : Word) : Word :=
+  (BitVec.ofInt 32 ((rv64w_low x).toInt * (rv64w_low y).toInt)).signExtend 64
+
+def rv64w_div (isUnsigned : Bool) (x y : Word) : Word :=
+  let a : Int := if isUnsigned then (rv64w_low x).toNat else (rv64w_low x).toInt
+  let b : Int := if isUnsigned then (rv64w_low y).toNat else (rv64w_low y).toInt
+  let q : Int := if b == 0 then -1 else Int.tdiv a b
+  let q : Int := if !isUnsigned && decide (q ≥ (2 : Int)^31) then -((2 : Int)^31) else q
+  (BitVec.ofInt 32 q).signExtend 64
+
+def rv64w_rem (isUnsigned : Bool) (x y : Word) : Word :=
+  let a : Int := if isUnsigned then (rv64w_low x).toNat else (rv64w_low x).toInt
+  let b : Int := if isUnsigned then (rv64w_low y).toNat else (rv64w_low y).toInt
+  let r : Int := if b == 0 then a else Int.tmod a b
+  (BitVec.ofInt 32 r).signExtend 64
+
