+#[cfg(test)]
+mod gate_semantic_tests {
+    use super::*;
+    #[test]
+    fn gate_nonpositive_generated_argument_is_a_typed_reject() {
+        let export=crate::gate_driver::gate_tests::generated_export(0);
+        let result=std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            export.with_tc(crate::env::EnvLimit::Empty,|tc| {
+                let levels=tc.ctx.alloc_levels_slice(&[]);
+                let name=tc.ctx.str1("GeneratedInductive");
+                let ind=tc.ctx.mk_const(name,levels);
+                let body=tc.ctx.prop();
+                let cursor=tc.ctx.mk_pi(name,crate::expr::BinderStyle::Default,ind,body);
+                let mut state=InductiveCheckState::new(levels,0,Vec::new(),Vec::new());
+                state.ind_consts.push(ind);
+                tc.check_positivity1(&state,cursor);
+            });
+        }));
+        assert_eq!(result.unwrap_err().downcast_ref::<crate::gate_fuel::Stop>(),Some(&crate::gate_fuel::Stop::Reject));
+    }
+}
