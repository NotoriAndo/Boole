[package]
name = "boole-air-extract"
version = "0.1.0"
edition = "2021"
publish = false
description = "Boole AIR extractor for SP1 (added to a scratch copy of the workspace; not upstream code)"

[[bin]]
name = "boole-air-extract"
path = "src/main.rs"

[dependencies]
sp1-core-machine = { workspace = true }
sp1-core-executor = { workspace = true }
sp1-hypercube = { workspace = true }
sp1-primitives = { workspace = true }
sp1-curves = { workspace = true }
sp1-recursion-machine = { workspace = true }
sp1-recursion-executor = { workspace = true }
slop-air = { workspace = true }
slop-algebra = { workspace = true }
slop-matrix = { workspace = true }
slop-uni-stark = { workspace = true }
num = { workspace = true }
