{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boole.local/schemas/zk-registry-problem-v1.json",
  "title": "ZK registry problem package (problem.json), version 1",
  "description": "One record per template instantiation. OPEN, GATE-FAIL and DET-FALSE-CANDIDATE records describe a package directory with Lean files; TOO-LARGE and UNINSTANTIABLE records are index rows without Lean files.",
  "type": "object",
  "required": ["schema_version", "package_id", "property", "status", "status_reason", "ids", "instantiation", "spec", "env", "generator"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "zk-registry-problem/v1"},
    "package_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"},
    "property": {
      "type": "object",
      "required": ["template", "name"],
      "additionalProperties": false,
      "properties": {
        "template": {"enum": ["DET"]},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "status": {"enum": ["OPEN", "TOO-LARGE", "UNINSTANTIABLE", "GATE-FAIL", "DET-FALSE-CANDIDATE", "NO-INSTANTIATION", "COMPILE-FAIL", "NOT-APPLICABLE"]},
    "status_reason": {"type": "string"},
    "ids": {
      "type": "object",
      "required": ["ledger_item_id", "repo", "repo_url", "release", "commit", "path", "template", "template_line", "source_sha256"],
      "additionalProperties": false,
      "properties": {
        "ledger_item_id": {"type": "string", "minLength": 1},
        "ledger": {
          "type": "object",
          "required": ["file", "sha256", "row_found"],
          "additionalProperties": false,
          "properties": {
            "file": {"type": "string"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "row_found": {"type": "boolean"}
          }
        },
        "repo": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
        "repo_url": {"type": "string", "pattern": "^https://"},
        "release": {"type": "string"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "path": {"type": "string", "minLength": 1},
        "template": {"type": "string", "minLength": 1},
        "template_line": {"type": "integer", "minimum": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "dependencies": {
          "description": "Library packages materialized next to the checkout for compilation (pinned by the repository's lockfile, build script or submodule gitlink).",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "version", "source", "path"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "registry_name": {"type": "string"},
              "version": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "integrity": {"type": "string"},
              "tarball_sha256": {"$ref": "#/$defs/sha256"},
              "resolved_by": {"type": "string"}
            }
          }
        }
      }
    },
    "instantiation": {
      "type": "object",
      "required": ["rule", "args", "call", "provenance", "selection", "candidates"],
      "additionalProperties": false,
      "properties": {
        "rule": {"enum": ["parameter-free", "repo-main", "repo-test", "repo-internal", "repo-derived", "documented-default", "probed", "decomposition", "contract-entrypoint", "none"]},
        "rule_order": {"type": "array", "items": {"type": "string"}},
        "args": {"type": "array", "items": {"type": "string"}},
        "call": {"type": "string"},
        "params": {"type": "array", "items": {"type": "string"}},
        "provenance": {"type": "array", "items": {"type": "string"}},
        "selection": {"type": "string"},
        "include_context": {"type": "string"},
        "include_main_removed": {"description": "The included file also declares a component main, which was blanked in a sibling copy for this compilation.", "type": "boolean"},
        "decomposition": {
          "description": "A sub-component instantiation harvested from TOO-LARGE instantiations (rule decomposition): its parents, depth below them, template content hash and the number of harvested variants of this content.",
          "type": "object",
          "required": ["parents", "n_parents", "depth", "content_sha256", "variants", "instance_key"],
          "additionalProperties": false,
          "properties": {
            "parents": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["call"], "additionalProperties": false,
                        "properties": {"package_id": {"type": "string"}, "key": {"type": "string"}, "call": {"type": "string"}}}},
            "n_parents": {"type": "integer", "minimum": 1},
            "depth": {"type": "integer", "minimum": 1},
            "content_sha256": {"$ref": "#/$defs/sha256"},
            "variants": {"type": "integer", "minimum": 1},
            "instance_key": {"type": "string"}
          }
        },
        "tag_wrapper": {
          "description": "The template's inputs carry known circom tags: it was compiled through a generated wrapper whose main inputs are untagged copies (same names and dimensions); statement.preconditions states the tags' preconditions.",
          "type": "object",
          "required": ["wrapper", "tagged_inputs"],
          "additionalProperties": false,
          "properties": {
            "wrapper": {"type": "string"},
            "tagged_inputs": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
            "tag_table_source": {"type": "string"}
          }
        },
        "main_sha256": {"$ref": "#/$defs/sha256"},
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tier", "call", "compile"],
            "additionalProperties": false,
            "properties": {
              "tier": {"type": "string"},
              "call": {"type": "string"},
              "compile": {"enum": ["ok", "error", "skipped"]},
              "include_context": {"type": "string"},
              "compiler": {"description": "Tag of the pinned compiler that produced this result (see circuit.compiler).", "type": "string"},
              "attempts": {
                "description": "Every (include context, compiler) compile tried for the candidate, in order, when more than one was tried.",
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["include_context", "compiler", "result"],
                  "additionalProperties": false,
                  "properties": {"include_context": {"type": "string"}, "compiler": {"type": "string"}, "result": {"type": "string"}}
                }
              },
              "constraints": {"type": "integer", "minimum": 0},
              "wires": {"type": "integer", "minimum": 1},
              "error": {"type": "string"}
            }
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["tier", "source", "clauses", "sha256"],
      "additionalProperties": false,
      "properties": {
        "tier": {"const": "T1"},
        "source": {"type": "string"},
        "clauses": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "circuit": {
      "type": "object",
      "required": ["compiler", "prime", "prime_name", "n_constraints", "n_wires", "size_policy"],
      "additionalProperties": false,
      "properties": {
        "compiler": {
          "type": "object",
          "required": ["name", "version", "flags", "binary_sha256"],
          "additionalProperties": false,
          "properties": {
            "name": {"enum": ["circom", "nargo"]},
            "version": {"type": "string"},
            "flags": {"type": "array", "items": {"type": "string"}},
            "binary_sha256": {"$ref": "#/$defs/sha256"},
            "source": {"type": "string"}
          }
        },
        "prime": {"type": "string", "pattern": "^[0-9]+$"},
        "prime_name": {"type": "string"},
        "n_constraints": {"type": "integer", "minimum": 0},
        "n_wires": {"type": "integer", "minimum": 1},
        "n_inputs": {"type": "integer", "minimum": 0},
        "n_outputs": {"type": "integer", "minimum": 0},
        "r1cs_sha256": {"$ref": "#/$defs/sha256"},
        "acir": {"description": "Noir packages: ACIR program statistics (sha256 of the decoded functions, opcode counts by kind, Brillig calls, black boxes, oracles, ACIR functions inlined); n_constraints counts the opcodes of the flattened main function.", "type": "object"},
        "sym_sha256": {"$ref": "#/$defs/sha256"},
        "size_policy": {
          "type": "object",
          "required": ["max_constraints", "within"],
          "additionalProperties": false,
          "properties": {
            "max_constraints": {"type": "integer", "minimum": 1},
            "within": {"type": "boolean"}
          }
        }
      }
    },
    "statement": {
      "type": "object",
      "required": ["file", "theorem", "theorem_fqn", "model_module", "model_file", "text", "assumptions", "truth"],
      "additionalProperties": false,
      "properties": {
        "file": {"const": "Statement.lean"},
        "theorem": {"type": "string"},
        "theorem_fqn": {"type": "string"},
        "model_module": {"type": "string"},
        "model_file": {"type": "string"},
        "text": {"type": "string"},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "preconditions": {
          "description": "DET under input preconditions: hypotheses Preconditions w1 and Preconditions w2 of the statement, one group per tagged main input signal.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["signal", "tag", "condition", "wires"],
            "additionalProperties": false,
            "properties": {
              "signal": {"type": "string", "pattern": "^main\\."},
              "tag": {"enum": ["binary", "maxbit"]},
              "value": {"type": ["integer", "null"], "minimum": 1},
              "condition": {"type": "string"},
              "wires": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}
            }
          }
        },
        "truth": {"enum": ["unknown", "false-counterexample-found", "closed-by-automation"]}
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "G-ELAB": {"$ref": "#/$defs/gate"},
        "G-NONVAC": {"$ref": "#/$defs/gate"},
        "G-FID": {"$ref": "#/$defs/gate"},
        "G-TRIV": {"$ref": "#/$defs/gate"},
        "DET-SEARCH": {"$ref": "#/$defs/gate"}
      }
    },
    "checker": {
      "type": "object",
      "required": ["statement_file", "theorem", "theorem_fqn", "lean_opts", "files", "reference_type_sha256", "replay_tool_sha256", "allowed_axioms", "forbidden_tokens"],
      "additionalProperties": false,
      "properties": {
        "statement_file": {"const": "Statement.lean"},
        "theorem": {"type": "string"},
        "theorem_fqn": {"type": "string"},
        "lean_opts": {"type": "array", "items": {"type": "string"}},
        "files": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["path", "role", "sha256"],
            "additionalProperties": false,
            "properties": {
              "path": {"type": "string"},
              "role": {"enum": ["statement", "import"]},
              "module": {"type": "string"},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "reference_type_sha256": {"$ref": "#/$defs/sha256"},
        "replay_tool_sha256": {"$ref": "#/$defs/sha256"},
        "allowed_axioms": {"type": "array", "items": {"type": "string"}},
        "forbidden_tokens": {"type": "array", "items": {"type": "string"}}
      }
    },
    "env": {
      "type": "object",
      "required": ["lean", "mathlib", "lake_manifest_sha256", "python"],
      "anyOf": [{"required": ["circom", "node"]}, {"required": ["nargo"]}],
      "additionalProperties": false,
      "properties": {
        "circom": {"type": "string"},
        "nargo": {"description": "Noir packages: the pinned nargo release or source build that compiled the circuit.", "type": "string"},
        "nargo_binary_sha256": {"$ref": "#/$defs/sha256"},
        "acir_tool_sha256": {"description": "Noir packages: the boole-acir-tool built against the same noir version (decoder and ACVM executor).", "type": "string"},
        "circom_binary_sha256": {"$ref": "#/$defs/sha256"},
        "lean": {"type": "string"},
        "mathlib": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "lake_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "packages": {"type": "object", "additionalProperties": {"type": "string"}},
        "node": {"type": "string"},
        "python": {"type": "string"}
      }
    },
    "generator": {
      "type": "object",
      "required": ["name", "version", "sources_sha256"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "sources_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence": {"type": "object"},
    "supersedes": {
      "description": "This record replaces an earlier record of the same package (e.g. after the P2 battery re-run); the package files are unchanged.",
      "type": "object",
      "required": ["status", "status_reason", "generator_sources_sha256"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["OPEN", "TOO-LARGE", "UNINSTANTIABLE", "GATE-FAIL", "DET-FALSE-CANDIDATE", "NO-INSTANTIATION", "COMPILE-FAIL", "NOT-APPLICABLE"]},
        "status_reason": {"type": "string"},
        "generator_sources_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["OPEN", "GATE-FAIL", "DET-FALSE-CANDIDATE"]}}},
      "then": {"required": ["circuit", "statement", "gates", "checker"]}
    },
    {
      "if": {"properties": {"status": {"const": "TOO-LARGE"}}},
      "then": {
        "required": ["circuit"],
        "properties": {"circuit": {"properties": {"size_policy": {"properties": {"within": {"const": false}}}}}}
      }
    },
    {
      "if": {"properties": {"status": {"const": "OPEN"}}},
      "then": {
        "properties": {
          "gates": {
            "required": ["G-ELAB", "G-NONVAC", "G-FID", "G-TRIV", "DET-SEARCH"],
            "properties": {
              "G-ELAB": {"properties": {"status": {"const": "PASS"}}},
              "G-NONVAC": {"properties": {"status": {"const": "PASS"}}},
              "G-FID": {"properties": {"status": {"const": "PASS"}}},
              "G-TRIV": {"properties": {"status": {"const": "PASS"}}}
            }
          },
          "statement": {"properties": {"truth": {"const": "unknown"}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "DET-FALSE-CANDIDATE"}}},
      "then": {"properties": {"statement": {"properties": {"truth": {"const": "false-counterexample-found"}}}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gate": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"enum": ["PASS", "FAIL", "SKIPPED", "ERROR"]}}
    }
  }
}
