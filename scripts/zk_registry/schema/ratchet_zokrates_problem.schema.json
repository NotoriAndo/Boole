{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zk-registry-ratchet-zokrates-problem/v1",
  "title": "Verified zokrates native-model ratchet problem",
  "description": "A Circom reference of the registry with its record (non-linear constraints of the canonical --O2 compile, main inputs public). Status OPEN: the problem package. Status CANDIDATE: the checker package the candidate pipeline generates for one candidate (candidate, statement and checker blocks). Answers are never part of a problem package.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "package_id",
    "status",
    "reference",
    "record",
    "metric",
    "admissibility",
    "statement_shape",
    "determinism",
    "det",
    "simulate",
    "snapshot",
    "env",
    "generator",
    "created_utc",
    "family"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "zk-registry-ratchet-zokrates-problem/v1"
    },
    "kind": {
      "const": "ratchet"
    },
    "package_id": {
      "type": "string",
      "pattern": "^ratchet/.+"
    },
    "status": {
      "enum": [
        "OPEN",
        "CANDIDATE"
      ]
    },
    "reference": {
      "type": "object",
      "required": [
        "registry_package_id",
        "repo",
        "repo_url",
        "commit",
        "path",
        "call",
        "lean_opts",
        "model",
        "compiler",
        "source_dir",
        "source",
        "io"
      ],
      "additionalProperties": false,
      "properties": {
        "registry_package_id": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "repo_url": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "call": {
          "type": "string",
          "minLength": 1
        },
        "lean_opts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "model": {
          "type": "object",
          "required": [
            "file",
            "module",
            "namespace",
            "sha256",
            "r1cs_sha256",
            "n_wires",
            "counts"
          ],
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string",
              "pattern": "\\.lean$"
            },
            "module": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "r1cs_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "n_wires": {
              "type": "integer",
              "minimum": 1
            },
            "counts": {
              "type": "object",
              "required": [
                "nonlinear",
                "linear",
                "total"
              ],
              "additionalProperties": false,
              "properties": {
                "nonlinear": {
                  "type": "integer",
                  "minimum": 0
                },
                "linear": {
                  "type": "integer",
                  "minimum": 0
                },
                "total": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "compiler": {
          "type": "object",
          "required": [
            "version",
            "binary_sha256",
            "style",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "version": {
              "enum": [
                "0.6.1",
                "0.8.8"
              ]
            },
            "binary_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "style": {
              "enum": [
                "brace",
                "colon"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "source_dir": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "required": [
            "file",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "io": {
          "type": "object",
          "required": [
            "prime",
            "prime_name",
            "input_names",
            "output_names",
            "input_types",
            "output_types",
            "n_pub_in",
            "n_prv_in"
          ],
          "additionalProperties": false,
          "properties": {
            "prime": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "prime_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "input_names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "output_names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "input_types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "output_types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "n_pub_in": {
              "type": "integer",
              "minimum": 0
            },
            "n_prv_in": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "record": {
      "type": "object",
      "required": [
        "nonlinear",
        "linear",
        "total",
        "r1cs_sha256",
        "rung",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "nonlinear": {
          "type": "integer",
          "minimum": 0
        },
        "linear": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "r1cs_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rung": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metric": {
      "type": "string",
      "minLength": 1
    },
    "admissibility": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "statement_shape": {
      "type": "string",
      "minLength": 1
    },
    "determinism": {
      "type": "string",
      "minLength": 1
    },
    "det": {
      "description": "Machine-checked DET of the reference model file: a proof of the registry statement `det` that the production checker accepted within the proof limits.",
      "type": "object",
      "required": [
        "method",
        "registry_package_id",
        "theorem_fqn",
        "model_file",
        "model_sha256",
        "proof_sha256",
        "proof_location",
        "source",
        "checker"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "mech-p3",
            "battery-closure",
            "det-problem"
          ]
        },
        "registry_package_id": {
          "type": "string"
        },
        "theorem_fqn": {
          "type": "string"
        },
        "model_file": {
          "type": "string"
        },
        "model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "proof_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "proof_location": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "form": {
          "type": "string"
        },
        "checker": {
          "type": "object",
          "required": [
            "verdict",
            "peak_rss_mb",
            "secs",
            "limits"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "const": "PASS"
            },
            "peak_rss_mb": {
              "type": [
                "integer",
                "null"
              ],
              "maximum": 20000
            },
            "secs": {
              "type": [
                "number",
                "null"
              ],
              "maximum": 1800
            },
            "limits": {
              "type": "object"
            }
          }
        }
      }
    },
    "simulate": {
      "type": "object",
      "required": [
        "seed"
      ],
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": "string",
          "minLength": 1
        },
        "profiles": {
          "type": [
            "string",
            "array"
          ]
        }
      }
    },
    "snapshot": {
      "type": "object",
      "required": [
        "id",
        "manifest_sha256",
        "n_files"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "n_files": {
          "type": "integer",
          "minimum": 0
        },
        "rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "env": {
      "type": "object",
      "required": [
        "lean",
        "mathlib",
        "lake_manifest_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "lean": {
          "type": "string",
          "minLength": 1
        },
        "mathlib": {
          "type": "string",
          "minLength": 1
        },
        "lake_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "packages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "python": {
          "type": "string",
          "minLength": 1
        },
        "zokrates": {
          "type": "string",
          "minLength": 1
        },
        "halo2": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generator": {
      "type": "object",
      "required": [
        "name",
        "version",
        "sources_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "boole-zk-registry-ratchet-zokrates"
        },
        "version": {
          "type": "string"
        },
        "sources_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "created_utc": {
      "type": "string"
    },
    "annotations": {
      "description": "Wave annotations (own-code share, size band, adoption evidence, content aliases); not part of the problem.",
      "type": "object"
    },
    "candidate": {
      "type": "object",
      "required": [
        "source_sha256",
        "r1cs_sha256",
        "raw_sha256",
        "model_sha256",
        "io",
        "nonlinear",
        "linear",
        "total",
        "smaller"
      ],
      "additionalProperties": false,
      "properties": {
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "r1cs_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "io": {
          "type": "object",
          "required": [
            "prime",
            "prime_name",
            "input_names",
            "output_names",
            "input_types",
            "output_types",
            "n_pub_in",
            "n_prv_in"
          ],
          "additionalProperties": false,
          "properties": {
            "prime": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "prime_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "input_names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "output_names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "input_types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "output_types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "n_pub_in": {
              "type": "integer",
              "minimum": 0
            },
            "n_prv_in": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "nonlinear": {
          "type": "integer",
          "minimum": 0
        },
        "linear": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "smaller": {
          "type": "boolean"
        }
      }
    },
    "statement": {
      "type": "object",
      "required": [
        "file",
        "theorem",
        "theorem_fqn",
        "text",
        "imports",
        "assumptions"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "const": "Statement.lean"
        },
        "theorem": {
          "const": "equiv"
        },
        "theorem_fqn": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "imports": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "checker": {
      "type": "object",
      "required": [
        "statement_file",
        "theorem",
        "theorem_fqn",
        "lean_opts",
        "files",
        "reference_type_sha256",
        "replay_tool_sha256",
        "allowed_axioms",
        "forbidden_tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "statement_file": {
          "const": "Statement.lean"
        },
        "theorem": {
          "const": "equiv"
        },
        "theorem_fqn": {
          "type": "string"
        },
        "lean_opts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "path",
              "role",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "statement",
                  "import"
                ]
              },
              "module": {
                "type": "string"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "reference_type_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "replay_tool_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "allowed_axioms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_tokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "family": {
      "const": "zokrates"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "CANDIDATE"
          }
        }
      },
      "then": {
        "required": [
          "candidate",
          "statement",
          "checker"
        ]
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "required": [
        "nonlinear",
        "linear",
        "total"
      ],
      "additionalProperties": false,
      "properties": {
        "nonlinear": {
          "type": "integer",
          "minimum": 0
        },
        "linear": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
