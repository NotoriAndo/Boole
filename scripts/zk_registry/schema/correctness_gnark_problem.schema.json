{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zk-registry-correctness-gnark-problem/v1",
  "title": "Gnark correctness property against an accepted local specification",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "family", "package_id", "status", "property", "binding",
               "binding_sha256", "spec", "nonvacuity", "battery", "trivial", "statement", "checker", "files",
               "env", "generator", "created_utc"],
  "properties": {
    "schema_version": {"const": "zk-registry-correctness-gnark-problem/v1"},
    "kind": {"const": "C"}, "family": {"const": "gnark"},
    "package_id": {"type": "string", "pattern": "^C/gnark/[0-9a-f]{64}$"},
    "status": {"enum": ["OPEN", "FACT"]}, "property": {"enum": ["soundness", "completeness"]},
    "binding_sha256": {"$ref": "#/$defs/sha"},
    "binding": {
      "type": "object",
      "required": ["id", "registry_package_id", "source", "gnark_version", "compiler", "original_metadata_sha256",
                   "wrapper_sha256", "harness_sha256", "model_module", "model_file", "model_sha256",
                   "original_r1cs_sha256", "n_wires", "n_constraints", "native_prime", "inputs", "native_outputs",
                   "emulated_outputs", "hints", "hint_semantics", "model_assumptions", "gnark_commitment_model",
                   "instantiation", "standard_function", "reference_operation", "parameter_field", "field_parameters",
                   "input_groups", "scalar_or_bit_inputs", "output_decoding", "reference_cost", "spec_width",
                   "spec_constant", "output_limb_bounds"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
        "model_file": {"type": "string", "pattern": "\\.lean$"}, "model_module": {"type": "string"},
        "model_sha256": {"$ref": "#/$defs/sha"}, "original_r1cs_sha256": {"$ref": "#/$defs/sha"},
        "original_metadata_sha256": {"$ref": "#/$defs/sha"}, "wrapper_sha256": {"$ref": "#/$defs/sha"},
        "harness_sha256": {"$ref": "#/$defs/sha"}, "n_wires": {"type": "integer", "minimum": 1},
        "n_constraints": {"type": "integer", "minimum": 0},
        "native_prime": {"type": "string", "pattern": "^[0-9]+$"},
        "inputs": {"type": "array"}, "native_outputs": {"type": "array"}, "emulated_outputs": {"type": "array"},
        "input_groups": {"type": "array"}, "scalar_or_bit_inputs": {"type": "array"},
        "field_parameters": {"type": "object", "required": ["modulus", "bits_per_limb", "nb_limbs"]},
        "reference_cost": {"type": "object", "required": ["nonlinear", "linear", "total"],
                           "properties": {"nonlinear": {"type": "integer", "minimum": 0},
                                          "linear": {"type": "integer", "minimum": 0},
                                          "total": {"type": "integer", "minimum": 0}}},
        "output_decoding": {"enum": ["raw-integer", "mod-foreign-q", "native-bit-vector", "acceptance-predicate"]},
        "spec_width": {"type": "integer", "minimum": 1}, "spec_constant": {"type": "integer", "minimum": 0},
        "output_limb_bounds": {"type": "boolean"}
      }
    },
    "spec": {"type": "object", "additionalProperties": false,
             "required": ["package_id", "sha256", "file", "specification_sha256"],
             "properties": {"package_id": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha"},
                            "file": {"const": "spec/problem.json"}, "specification_sha256": {"$ref": "#/$defs/sha"}}},
    "nonvacuity": {"type": "object", "required": ["status", "file", "sha256", "witness_file", "witness_sha256"],
                   "properties": {"status": {"const": "NONVACUOUS"}, "file": {"type": "string"},
                                  "sha256": {"$ref": "#/$defs/sha"}, "witness_file": {"type": "string"},
                                  "witness_sha256": {"$ref": "#/$defs/sha"}}},
    "battery": {"type": "object", "required": ["file", "sha256", "forms", "attempts", "checker_verdict"],
                "properties": {"file": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha"},
                               "forms": {"type": "array", "minItems": 7, "items": {"type": "string"}},
                               "attempts": {"type": "array", "minItems": 1,
                                            "items": {"type": "object", "required": ["index", "completed", "closed"],
                                                      "properties": {"index": {"type": "integer", "minimum": 1, "maximum": 7},
                                                                     "completed": {"type": "boolean"},
                                                                     "closed": {"type": "boolean"}}}},
                               "checker_verdict": {"type": ["string", "null"]}}},
    "trivial": {"type": "object", "additionalProperties": false, "required": ["structural", "battery"],
                "properties": {"structural": {"type": "boolean"}, "battery": {"type": "boolean"}}},
    "statement": {"type": "object", "additionalProperties": false,
                  "required": ["file", "module", "propositions_file", "bindings_file", "theorem", "theorem_fqn",
                               "text", "imports"],
                  "properties": {"file": {"const": "ProofStatement.lean"}, "module": {"const": "Statements"},
                                 "propositions_file": {"const": "Statements.lean"},
                                 "bindings_file": {"const": "Bindings.lean"}, "theorem": {"const": "solution"},
                                 "theorem_fqn": {"type": "string"}, "text": {"type": "string"},
                                 "imports": {"const": ["Statements"]}}},
    "checker": {"type": "object", "additionalProperties": false,
                "required": ["statement_file", "theorem", "theorem_fqn", "lean_opts", "files", "reference_type_sha256",
                             "replay_tool_sha256", "allowed_axioms", "forbidden_tokens", "limits"],
                "properties": {"statement_file": {"const": "ProofStatement.lean"}, "theorem": {"const": "solution"},
                               "theorem_fqn": {"type": "string"}, "lean_opts": {"type": "array"},
                               "files": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/file"}},
                               "reference_type_sha256": {"$ref": "#/$defs/sha"},
                               "replay_tool_sha256": {"$ref": "#/$defs/sha"}, "allowed_axioms": {"type": "array"},
                               "forbidden_tokens": {"type": "array"},
                               "limits": {"const": {"timeout_seconds": 1800, "rss_mb": 12000}}}},
    "files": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/file"}},
    "env": {"type": "object", "additionalProperties": false,
            "required": ["lean", "mathlib", "lake_manifest_sha256", "packages"],
            "properties": {"lean": {"type": "string"}, "mathlib": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                           "lake_manifest_sha256": {"$ref": "#/$defs/sha"}, "packages": {"type": "object"}}},
    "generator": {"type": "object", "required": ["name", "version"],
                  "properties": {"name": {"const": "boole-zk-registry-correctness-gnark"}, "version": {"const": "1.0"}}},
    "created_utc": {"type": "string", "pattern": "Z$"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "role"],
             "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"},
                            "role": {"enum": ["import", "statement", "evidence"]}, "module": {"type": "string"}}}
  }
}
