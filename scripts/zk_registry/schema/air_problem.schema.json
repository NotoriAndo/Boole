{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boole.local/schemas/zk-registry-air-problem-v1.json",
  "title": "ZK registry AIR problem package (problem.json), version 1",
  "description": "One record per extracted zkVM AIR. OPEN, GATE-FAIL and DET-FALSE-CANDIDATE records describe a package directory with Lean files; TOO-LARGE and EXTRACTION-FAILED records are index rows without Lean files.",
  "type": "object",
  "required": ["schema_version", "package_id", "property", "status", "status_reason", "ids", "spec", "coverage", "env", "generator"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "zk-registry-air-problem/v1"},
    "package_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"},
    "property": {
      "type": "object",
      "required": ["template", "name"],
      "additionalProperties": false,
      "properties": {"template": {"enum": ["DET"]}, "name": {"type": "string", "minLength": 1}}
    },
    "status": {"enum": ["OPEN", "TOO-LARGE", "EXTRACTION-FAILED", "GATE-FAIL", "DET-FALSE-CANDIDATE"]},
    "status_reason": {"type": "string"},
    "ids": {
      "type": "object",
      "required": ["ledger_item_id", "zkvm", "repo", "repo_url", "release", "commit", "air_name", "rust_type", "air_index", "group"],
      "additionalProperties": false,
      "properties": {
        "ledger_item_id": {"type": "string", "minLength": 1},
        "ledger": {
          "type": "object",
          "required": ["file", "sha256", "row_found"],
          "additionalProperties": false,
          "properties": {"file": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}, "row_found": {"type": "boolean"}}
        },
        "zkvm": {"enum": ["sp1", "pico", "openvm"]},
        "repo": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
        "repo_url": {"type": "string", "pattern": "^https://"},
        "release": {"type": "string"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "air_name": {"type": "string", "minLength": 1},
        "rust_type": {"type": "string", "minLength": 1},
        "air_index": {"type": "integer", "minimum": 0},
        "group": {"type": "string"},
        "copy_of": {"description": "An earlier AIR of the same wave with identical extracted content (constraints, interactions, widths).", "type": "string"}
      }
    },
    "spec": {
      "type": "object",
      "required": ["tier", "source", "clauses", "sha256"],
      "additionalProperties": false,
      "properties": {
        "tier": {"const": "T1"},
        "source": {"type": "string"},
        "clauses": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "air": {
      "type": "object",
      "required": ["field", "p", "width", "preprocessed_width", "num_public_values", "window_rows", "n_constraints", "n_nodes", "n_interactions", "ir_sha256", "content_sha256", "extractor", "size_policy"],
      "additionalProperties": false,
      "properties": {
        "field": {"enum": ["BabyBear", "KoalaBear"]},
        "p": {"type": "integer"},
        "width": {"type": "integer", "minimum": 0},
        "preprocessed_width": {"type": "integer", "minimum": 0},
        "num_public_values": {"type": "integer", "minimum": 0},
        "window_rows": {"enum": [1, 2]},
        "n_vars": {"type": "integer", "minimum": 0},
        "n_constraints": {"type": "integer", "minimum": 0},
        "n_nodes": {"type": "integer", "minimum": 0},
        "degree": {"type": "integer", "minimum": 0},
        "n_interactions": {"type": "integer", "minimum": 0},
        "ir_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "selectors": {"type": "array", "items": {"enum": ["first", "last", "trans"]}},
        "extractor": {
          "type": "object",
          "required": ["harness_sha256", "builder", "rust_toolchain"],
          "additionalProperties": false,
          "properties": {
            "harness_sha256": {"$ref": "#/$defs/sha256"},
            "builder": {"type": "string"},
            "rust_toolchain": {"type": "string"},
            "toolchain_deviation": {"type": "string"},
            "features": {"type": "string"}
          }
        },
        "size_policy": {
          "type": "object",
          "required": ["max_constraints", "max_nodes", "within"],
          "additionalProperties": false,
          "properties": {
            "max_constraints": {"type": "integer", "minimum": 1},
            "max_nodes": {"type": "integer", "minimum": 1},
            "within": {"type": "boolean"}
          }
        }
      }
    },
    "interface": {
      "description": "The role of every interaction in the DET statement, from the recorded bus model.",
      "type": "object",
      "required": ["bus_model", "inputs", "outputs", "assumptions", "fixed_vars"],
      "additionalProperties": false,
      "properties": {
        "bus_model": {"type": "object", "required": ["name", "sha256"], "additionalProperties": false,
                      "properties": {"name": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/msg"}},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/msg"}},
        "assumptions": {"type": "array", "items": {"$ref": "#/$defs/msg"}},
        "fixed_vars": {"type": "integer", "minimum": 0},
        "ignored": {"type": "array", "items": {"$ref": "#/$defs/msg"}}
      }
    },
    "coverage": {
      "description": "Public machine-checked artifacts that already answer DET or functional correctness of this AIR (issuance can exclude answered items).",
      "type": "object",
      "required": ["status", "sources"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["none", "partial", "full"]},
        "sources": {"type": "array", "items": {"type": "object", "required": ["name", "url", "pin", "scope"], "additionalProperties": false,
                    "properties": {"name": {"type": "string"}, "url": {"type": "string"}, "pin": {"type": "string"}, "scope": {"type": "string"},
                                   "note": {"type": "string"}, "same_code": {"type": "boolean"}}}},
        "note": {"type": "string"}
      }
    },
    "statement": {
      "type": "object",
      "required": ["file", "theorem", "theorem_fqn", "model_module", "model_file", "text", "assumptions", "truth", "window_rows"],
      "additionalProperties": false,
      "properties": {
        "file": {"const": "Statement.lean"},
        "theorem": {"type": "string"},
        "theorem_fqn": {"type": "string"},
        "model_module": {"type": "string"},
        "model_file": {"type": "string"},
        "text": {"type": "string"},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "window_rows": {"enum": [1, 2]},
        "truth": {"enum": ["unknown", "false-counterexample-found", "closed-by-automation", "window-false-counterexample-found"]}
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "G-ELAB": {"$ref": "#/$defs/gate"},
        "G-NONVAC": {"$ref": "#/$defs/gate"},
        "G-FID": {"$ref": "#/$defs/gate"},
        "G-TRIV": {"$ref": "#/$defs/gate"},
        "DET-SEARCH": {"$ref": "#/$defs/gate"}
      }
    },
    "checker": {
      "type": "object",
      "required": ["statement_file", "theorem", "theorem_fqn", "lean_opts", "files", "reference_type_sha256", "replay_tool_sha256", "allowed_axioms", "forbidden_tokens"],
      "additionalProperties": false,
      "properties": {
        "statement_file": {"const": "Statement.lean"},
        "theorem": {"type": "string"},
        "theorem_fqn": {"type": "string"},
        "lean_opts": {"type": "array", "items": {"type": "string"}},
        "files": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["path", "role", "sha256"],
            "additionalProperties": false,
            "properties": {"path": {"type": "string"}, "role": {"enum": ["statement", "import"]}, "module": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}
          }
        },
        "reference_type_sha256": {"$ref": "#/$defs/sha256"},
        "replay_tool_sha256": {"$ref": "#/$defs/sha256"},
        "allowed_axioms": {"type": "array", "items": {"type": "string"}},
        "forbidden_tokens": {"type": "array", "items": {"type": "string"}}
      }
    },
    "env": {
      "type": "object",
      "required": ["lean", "mathlib", "lake_manifest_sha256", "python", "rust"],
      "additionalProperties": false,
      "properties": {
        "lean": {"type": "string"},
        "mathlib": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "lake_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "packages": {"type": "object", "additionalProperties": {"type": "string"}},
        "python": {"type": "string"},
        "rust": {"type": "string"}
      }
    },
    "generator": {
      "type": "object",
      "required": ["name", "version", "sources_sha256"],
      "additionalProperties": false,
      "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "sources_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "evidence": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["OPEN", "GATE-FAIL", "DET-FALSE-CANDIDATE"]}}},
      "then": {"required": ["air", "interface", "statement", "gates", "checker"]}
    },
    {
      "if": {"properties": {"status": {"const": "TOO-LARGE"}}},
      "then": {"required": ["air"], "properties": {"air": {"properties": {"size_policy": {"properties": {"within": {"const": false}}}}}}}
    },
    {
      "if": {"properties": {"status": {"const": "OPEN"}}},
      "then": {
        "properties": {
          "gates": {
            "required": ["G-ELAB", "G-NONVAC", "G-FID", "G-TRIV", "DET-SEARCH"],
            "properties": {
              "G-ELAB": {"properties": {"status": {"const": "PASS"}}},
              "G-NONVAC": {"properties": {"status": {"const": "PASS"}}},
              "G-FID": {"properties": {"status": {"const": "PASS"}}},
              "G-TRIV": {"properties": {"status": {"const": "PASS"}}}
            }
          },
          "statement": {"properties": {"truth": {"const": "unknown"}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "DET-FALSE-CANDIDATE"}}},
      "then": {"properties": {"statement": {"properties": {"truth": {"const": "false-counterexample-found"}, "window_rows": {"const": 1}}}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gate": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["PASS", "FAIL", "SKIPPED", "ERROR"]}}},
    "msg": {
      "type": "object",
      "required": ["interaction", "direction", "bus", "role"],
      "additionalProperties": false,
      "properties": {
        "interaction": {"type": "integer", "minimum": 0},
        "direction": {"enum": ["send", "receive"]},
        "bus": {"type": "string"},
        "role": {"type": "string"},
        "fields": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "table": {"type": "string"},
        "reason": {"type": "string"}
      }
    }
  }
}
