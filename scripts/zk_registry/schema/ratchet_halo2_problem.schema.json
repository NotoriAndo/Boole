      "type": "string",
      "minLength": 1
    },
    "determinism": {
      "type": "string",
      "minLength": 1
    },
    "det": {
      "description": "Machine-checked DET of the reference model file: a proof of the registry statement `det` that the production checker accepted within the proof limits.",
      "type": "object",
      "required": [
        "method",
        "registry_package_id",
        "theorem_fqn",
        "model_file",
        "model_sha256",
        "proof_sha256",
        "proof_location",
        "source",
        "checker"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "mech-p3",
            "battery-closure",
            "det-problem"
          ]
        },
        "registry_package_id": {
          "type": "string"
        },
        "theorem_fqn": {
          "type": "string"
        },
        "model_file": {
          "type": "string"
        },
        "model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "proof_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "proof_location": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "form": {
          "type": "string"
        },
        "checker": {
          "type": "object",
          "required": [
            "verdict",
            "peak_rss_mb",
            "secs",
            "limits"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "const": "PASS"
            },
            "peak_rss_mb": {
              "type": [
                "integer",
                "null"
              ],
              "maximum": 20000
            },
            "secs": {
              "type": [
                "number",
                "null"
              ],
              "maximum": 1800
            },
            "limits": {
              "type": "object"
            }
          }
        }
      }
    },
    "simulate": {
      "type": "object",
      "required": [
        "seed"
      ],
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": "string",
          "minLength": 1
        },
        "profiles": {
          "type": [
            "string",
            "array"
          ]
        }
      }
    },
    "snapshot": {
      "type": "object",
      "required": [
