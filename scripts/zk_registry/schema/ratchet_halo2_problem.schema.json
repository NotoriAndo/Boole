        "model_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ir_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "io": {
          "type": "object",
          "required": [
            "prime",
            "prime_name",
            "input_names",
            "output_names",
            "instance_columns"
          ],
          "additionalProperties": false,
          "properties": {
            "prime": {
              "type": "string",
              "minLength": 1
            },
            "prime_name": {
              "type": "string",
              "minLength": 1
            },
            "input_names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "output_names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "instance_columns": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "cost": {
          "type": "object",
          "required": [
            "domain_rows",
            "advice_columns",
            "fixed_columns",
            "gate_instances",
            "copies",
            "lookups",
            "degree_ge",
            "priced",
            "variables",
            "nodes",
            "max_degree"
          ],
          "additionalProperties": false,
          "properties": {
            "domain_rows": {
              "type": "integer",
              "minimum": 1
            },
            "advice_columns": {
              "type": "integer",
              "minimum": 0
            },
            "fixed_columns": {
              "type": "integer",
              "minimum": 0
            },
            "gate_instances": {
              "type": "integer",
              "minimum": 0
            },
            "copies": {
              "type": "integer",
              "minimum": 0
            },
            "lookups": {
              "type": "integer",
              "minimum": 0
            },
            "degree_ge": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "priced": {
              "type": "integer",
              "minimum": 0
            },
            "variables": {
              "type": "integer",
              "minimum": 0
            },
            "nodes": {
              "type": "integer",
              "minimum": 0
            },
            "max_degree": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "smaller": {
          "type": "boolean"
        },
        "larger_components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "smaller_components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "statement": {
      "type": "object",
      "required": [
        "file",
        "theorem",
        "theorem_fqn",
        "text",
        "imports",
        "assumptions"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "const": "Statement.lean"
        },
        "theorem": {
          "const": "equiv"
        },
        "theorem_fqn": {
          "type": "string"
        },
