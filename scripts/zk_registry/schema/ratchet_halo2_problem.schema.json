          "type": "string",
          "minLength": 1
        },
        "repo_url": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "call": {
          "type": "string",
          "minLength": 1
        },
        "lean_opts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "model": {
          "type": "object",
          "required": [
            "file",
            "module",
            "namespace",
            "sha256",
            "ir_sha256",
            "n_wires",
            "cost"
