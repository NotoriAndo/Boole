      "then": {
        "required": [
          "candidate",
          "statement",
          "checker"
        ]
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "required": [
        "nonlinear",
        "linear",
        "total"
      ],
      "additionalProperties": false,
      "properties": {
        "nonlinear": {
          "type": "integer",
          "minimum": 0
        },
        "linear": {
          "type": "integer",
          "minimum": 0
