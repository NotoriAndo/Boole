      "type": "object",
      "required": [
        "name",
        "version",
        "sources_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "boole-zk-registry-ratchet-halo2"
        },
        "version": {
          "type": "string"
        },
        "sources_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "created_utc": {
      "type": "string"
    },
    "annotations": {
      "description": "Wave annotations (own-code share, size band, adoption evidence, content aliases); not part of the problem.",
      "type": "object"
    },
    "candidate": {
      "type": "object",
      "required": [
        "source_sha256",
        "model_sha256",
        "ir_sha256",
        "io",
        "cost",
        "smaller",
        "larger_components",
        "smaller_components"
      ],
      "additionalProperties": false,
      "properties": {
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
