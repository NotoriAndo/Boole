    "record": {
      "type": "object",
      "required": [
        "domain_rows",
        "advice_columns",
        "fixed_columns",
        "gate_instances",
        "copies",
        "lookups",
        "degree_ge",
        "priced",
        "variables",
        "nodes",
        "max_degree",
        "rung",
        "source"
