          "type": "integer",
          "minimum": 0
        },
        "rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "env": {
      "type": "object",
      "required": [
        "lean",
        "mathlib",
        "lake_manifest_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "lean": {
          "type": "string",
          "minLength": 1
        },
        "mathlib": {
          "type": "string",
          "minLength": 1
        },
        "lake_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "packages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "python": {
          "type": "string",
          "minLength": 1
        },
        "zokrates": {
          "type": "string",
          "minLength": 1
        },
        "halo2": {
          "type": "string",
          "minLength": 1
        }
      }
