            "output_names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "instance_columns": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "target": {
          "type": "object",
          "required": [
            "test",
            "package",
            "workspace",
            "source",
            "field",
            "line"
          ],
          "additionalProperties": false,
          "properties": {
            "test": {
              "type": "string",
              "minLength": 1
            },
            "package": {
              "type": "string",
              "minLength": 1
            },
            "workspace": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "field": {
              "type": "string",
              "minLength": 1
            },
            "line": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "build": {
          "type": "object",
          "required": [
            "toolchain",
            "command",
            "editable",
            "protected",
            "cargo_lock_sha256",
            "wrapper_sha256",
            "exporter_sha256",
            "rustc_sha256",
            "cargo_sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "toolchain": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "editable": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "protected": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cargo_lock_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "wrapper_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "exporter_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "rustc_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "cargo_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
