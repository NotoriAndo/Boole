                "domain_rows",
                "advice_columns",
                "fixed_columns",
                "gate_instances",
                "copies",
                "lookups",
                "degree_ge",
                "priced",
                "variables",
                "nodes",
                "max_degree"
              ],
              "additionalProperties": false,
              "properties": {
                "domain_rows": {
                  "type": "integer",
                  "minimum": 1
                },
                "advice_columns": {
                  "type": "integer",
                  "minimum": 0
                },
                "fixed_columns": {
                  "type": "integer",
                  "minimum": 0
                },
                "gate_instances": {
                  "type": "integer",
                  "minimum": 0
                },
                "copies": {
                  "type": "integer",
                  "minimum": 0
                },
                "lookups": {
                  "type": "integer",
                  "minimum": 0
                },
