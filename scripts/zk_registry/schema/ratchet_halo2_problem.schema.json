              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "model_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "io": {
          "type": "object",
          "required": [
            "prime",
            "prime_name",
            "input_names",
            "output_names",
