{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zk-registry-ratchet-halo2-problem/v1",
  "title": "Verified halo2 native-model ratchet problem",
  "description": "A Circom reference of the registry with its record (non-linear constraints of the canonical --O2 compile, main inputs public). Status OPEN: the problem package. Status CANDIDATE: the checker package the candidate pipeline generates for one candidate (candidate, statement and checker blocks). Answers are never part of a problem package.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "package_id",
    "status",
    "reference",
    "record",
    "metric",
    "admissibility",
    "statement_shape",
    "determinism",
    "det",
    "simulate",
    "snapshot",
    "env",
    "generator",
    "created_utc",
    "family"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "zk-registry-ratchet-halo2-problem/v1"
    },
    "kind": {
      "const": "ratchet"
    },
    "package_id": {
      "type": "string",
      "pattern": "^ratchet/.+"
    },
    "status": {
      "enum": [
        "OPEN",
        "CANDIDATE"
      ]
    },
    "reference": {
      "type": "object",
      "required": [
        "registry_package_id",
        "repo",
        "repo_url",
        "commit",
        "path",
        "call",
        "lean_opts",
        "model",
        "compiler",
        "ir",
