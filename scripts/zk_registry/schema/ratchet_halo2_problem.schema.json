                  "type": "object",
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "priced": {
                  "type": "integer",
                  "minimum": 0
                },
                "variables": {
                  "type": "integer",
                  "minimum": 0
                },
                "nodes": {
                  "type": "integer",
                  "minimum": 0
                },
                "max_degree": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "compiler": {
          "type": "object",
