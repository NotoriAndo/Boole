      "properties": {
        "domain_rows": {
          "type": "integer",
          "minimum": 1
        },
        "advice_columns": {
          "type": "integer",
          "minimum": 0
        },
        "fixed_columns": {
          "type": "integer",
          "minimum": 0
        },
        "gate_instances": {
          "type": "integer",
          "minimum": 0
        },
        "copies": {
          "type": "integer",
          "minimum": 0
        },
        "lookups": {
          "type": "integer",
          "minimum": 0
        },
        "degree_ge": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
