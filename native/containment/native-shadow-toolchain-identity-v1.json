    },
    "rustcProbe": [
      "/opt/boole/native-checker-toolchain/bin/rustc",
      "-vV"
    ],
    "cargoProbe": [
      "/opt/boole/native-checker-toolchain/bin/cargo",
      "-Vv"
    ]
  },
  "python": {
    "path": "/usr/bin/python3.12",
    "implementation": "cpython",
    "requiredVersionPrefix": "Python 3.12.",
    "versionProbe": [
      "/usr/bin/python3.12",
      "--version"
    ],
    "implementationProbe": [
      "/usr/bin/python3.12",
      "-I",
      "-S",
      "-c",
      "import sys;print(sys.implementation.name)"
    ],
    "requiredImplementationOutput": "cpython\n"
  },
  "runtimeVerification": {
    "runBeforeSocketBind": true,
    "runBeforeEachExecution": true,
    "productionByteProvenanceComplete": false,
    "executionAllowedBeforeProvenanceClosure": false,
    "activationBlockers": [
      "installed-rust-toolchain-file-manifest",
      "python-interpreter-and-stdlib-file-manifest",
      "system-linker-and-runtime-file-manifest"
    ],
    "environment": {
      "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
      "LC_ALL": "C",
      "LANG": "C",
      "TZ": "UTC"
    },
    "toolchainDigestMeaning": "sha256-of-these-exact-tracked-manifest-bytes",
    "probeMismatchAction": "fail-closed-before-spawn",
    "compatibilityProbeScope": "version-and-implementation-only;not-installed-byte-provenance"
  }
