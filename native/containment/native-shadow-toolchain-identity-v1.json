    "cargoRelease": "1.99.0-nightly",
    "cargoCommitHash": "3efb1f477e99b42974b982d939fd100303cdf7db",
    "linuxX8664ArtifactSha256": {
      "rustc-nightly-x86_64-unknown-linux-gnu.tar.xz": "12cd470422b39da22a7b8c2f069c25e66200d5a46c1be5dac0bfe7620ed0d415",
      "rust-std-nightly-x86_64-unknown-linux-gnu.tar.xz": "fd04194fb361ef69735a0b722fcaf6d9b49a339944f485aebcc4c172adb5c339",
