    "status": "FALSIFIED-AS-LOGICAL-PATH-PROOF",
    "joinedMultiComponentRawNeedleSearchIsASupersetOfLogicalPathEnumeration": false,
    "forbiddenInference": "raw-zero-for-a-joined-multi-component-path-needle-implies-logical-path-absence",
    "rawHostIdentityMarkerHitProvesHostOriginOrLeak": false,
    "secondForbiddenInference": "raw-hit-on-a-host-identity-tier-needle-proves-the-bytes-came-from-the-host-or-are-a-secret-leak",
    "why": "An ext4 logical path is reconstructed by traversing separately stored directory entries. Parent component .boole and child component keys can exist without the contiguous byte string .boole/keys occurring anywhere in the image. A single raw string such as BOOLE_LLM_API_KEY or boole-artifacts can also occur in source, documentation or an ordinary guest file, so the bytes alone do not prove host origin or a secret leak. A whole-image byte scan is useful for raw candidate discovery but proves neither logical-path absence nor provenance."
  },
